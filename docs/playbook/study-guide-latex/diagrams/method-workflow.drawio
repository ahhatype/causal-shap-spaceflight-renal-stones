<?xml version='1.0' encoding='utf-8'?>
<mxfile host="app.diagrams.net" type="device" version="26.0.0">
  <diagram id="method-workflow" name="Method Workflow">
    <mxGraphModel grid="1" gridSize="10" guides="1" connect="1" arrows="1" page="1" pageScale="1" pageWidth="700" pageHeight="760" math="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="stage-0" value="&lt;div style=&quot;font-size:14px;font-weight:bold;color:#27647b;&quot;&gt;0 Specify the goal and population&lt;/div&gt;&lt;div style=&quot;font-size:12.5px;margin-top:5px;color:#203647;&quot;&gt;Prediction, intervention effect, or causal allocation?&lt;br&gt;Name the outcome, horizon, contrast and target population.&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Helvetica;strokeColor=#27647b;fillColor=#f0f5f6;strokeWidth=1.2;spacing=5;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="180" y="15" width="500" height="66" />
        </mxCell>
        <mxCell id="stage-1" value="&lt;div style=&quot;font-size:14px;font-weight:bold;color:#27647b;&quot;&gt;1 Prepare the DAG and data; fit a reference model&lt;/div&gt;&lt;div style=&quot;font-size:12.5px;margin-top:5px;color:#203647;&quot;&gt;Plausible DAG + observed data or simulation&lt;br&gt;Predictive model and ordinary SHAP reference&lt;/div&gt;&lt;div style=&quot;font-size:10.7px;margin-top:5px;color:#586873;&quot;&gt;Manuscript Steps 1-4&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Helvetica;strokeColor=#27647b;fillColor=#f0f5f6;strokeWidth=1.2;spacing=5;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="180" y="99" width="500" height="82" />
        </mxCell>
        <mxCell id="stage-2" value="&lt;div style=&quot;font-size:14px;font-weight:bold;color:#397b71;&quot;&gt;2 OPTIONAL: learn candidate causal structure&lt;/div&gt;&lt;div style=&quot;font-size:12.5px;margin-top:5px;color:#203647;&quot;&gt;PC / PC-stable; context-dependent alternatives:&lt;br&gt;GES, LiNGAM, NOTEARS, mixed-data tests&lt;/div&gt;&lt;div style=&quot;font-size:10.7px;margin-top:5px;color:#586873;&quot;&gt;Ng PC + IDA route: Step 6; structure checks: Step 8&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Helvetica;strokeColor=#397b71;fillColor=#f0f5f6;strokeWidth=1.2;spacing=5;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="180" y="199" width="500" height="82" />
        </mxCell>
        <mxCell id="stage-3" value="&lt;div style=&quot;font-size:14px;font-weight:bold;color:#397b71;&quot;&gt;3 Review the graph and estimate mechanisms&lt;/div&gt;&lt;div style=&quot;font-size:12.5px;margin-top:5px;color:#203647;&quot;&gt;Expert review + temporal constraints; assess identification&lt;br&gt;Retain uncertain arrows and alternative graphs&lt;/div&gt;&lt;div style=&quot;font-size:10.7px;margin-top:5px;color:#586873;&quot;&gt;Manuscript Steps 2 and 6&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Helvetica;strokeColor=#397b71;fillColor=#f0f5f6;strokeWidth=1.2;spacing=5;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="180" y="299" width="500" height="82" />
        </mxCell>
        <mxCell id="stage-4" value="&lt;div style=&quot;font-size:14px;font-weight:bold;color:#397b71;&quot;&gt;4 Define the causal game and graph surgery&lt;/div&gt;&lt;div style=&quot;font-size:12.5px;margin-top:5px;color:#203647;&quot;&gt;do: set coalition nodes, remove their incoming arrows,&lt;br&gt;then propagate through the remaining mechanisms.&lt;br&gt;Ordering- and edge-based games use their own rules.&lt;/div&gt;&lt;div style=&quot;font-size:10.7px;margin-top:5px;color:#586873;&quot;&gt;Manuscript Step 6&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Helvetica;strokeColor=#397b71;fillColor=#f0f5f6;strokeWidth=1.2;spacing=5;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="180" y="399" width="500" height="98" />
        </mxCell>
        <mxCell id="stage-5" value="&lt;div style=&quot;font-size:14px;font-weight:bold;color:#397b71;&quot;&gt;5 Compute causal attributions, if requested&lt;/div&gt;&lt;div style=&quot;font-size:12.5px;margin-top:5px;color:#203647;&quot;&gt;Heskes / do-Shapley; Ng PC + IDA;&lt;br&gt;asymmetric Shapley values (ASV); Shapley Flow&lt;/div&gt;&lt;div style=&quot;font-size:10.7px;margin-top:5px;color:#586873;&quot;&gt;Methods allocate different quantities; match the target (Step 6).&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Helvetica;strokeColor=#397b71;fillColor=#f0f5f6;strokeWidth=1.2;spacing=5;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="180" y="509" width="500" height="82" />
        </mxCell>
        <mxCell id="stage-6" value="&lt;div style=&quot;font-size:14px;font-weight:bold;color:#27647b;&quot;&gt;6 Compare and validate on a shared degradation path&lt;/div&gt;&lt;div style=&quot;font-size:12.5px;margin-top:5px;color:#203647;&quot;&gt;Clean -&amp;gt; smaller sample / selection / measurement noise&lt;br&gt;Match causal targets and computational budgets.&lt;br&gt;Report uncertainty, failures and sensitivity.&lt;/div&gt;&lt;div style=&quot;font-size:10.7px;margin-top:5px;color:#586873;&quot;&gt;Manuscript Steps 8-11&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Helvetica;strokeColor=#27647b;fillColor=#f0f5f6;strokeWidth=1.2;spacing=5;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="180" y="622" width="500" height="96" />
        </mxCell>
        <mxCell id="next-0" edge="1" parent="1" source="stage-0" target="stage-1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#27647b;strokeWidth=1.3;endArrow=block;endFill=1;endSize=7;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="next-1" edge="1" parent="1" source="stage-1" target="stage-2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#397b71;strokeWidth=1.3;endArrow=block;endFill=1;endSize=7;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="next-2" edge="1" parent="1" source="stage-2" target="stage-3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#397b71;strokeWidth=1.3;endArrow=block;endFill=1;endSize=7;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="next-3" edge="1" parent="1" source="stage-3" target="stage-4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#397b71;strokeWidth=1.3;endArrow=block;endFill=1;endSize=7;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="next-4" edge="1" parent="1" source="stage-4" target="stage-5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#397b71;strokeWidth=1.3;endArrow=block;endFill=1;endSize=7;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="next-5" edge="1" parent="1" source="stage-5" target="stage-6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#27647b;strokeWidth=1.3;endArrow=block;endFill=1;endSize=7;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="prediction-only" edge="1" parent="1" source="stage-1" target="stage-6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#27647b;strokeWidth=1.3;endArrow=block;endFill=1;endSize=7;exitX=0;exitY=0.32;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;">
          <mxGeometry as="geometry" relative="1">
            <Array as="points">
              <mxPoint x="5" y="125.24" />
              <mxPoint x="5" y="670" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="prediction-label" value="Prediction only:&lt;br&gt;skip the causal route&lt;br&gt;and go to validation." vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;spacing=0;fontFamily=Helvetica;fontSize=12.3;fontColor=#27647b;fontStyle=0;align=center;verticalAlign=middle;">
          <mxGeometry as="geometry" x="13" y="201" width="133" height="68" />
        </mxCell>
        <mxCell id="supplied-dag" edge="1" parent="1" source="stage-1" target="stage-3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#397b71;strokeWidth=1.3;endArrow=block;endFill=1;endSize=7;exitX=0;exitY=0.75;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;">
          <mxGeometry as="geometry" relative="1">
            <Array as="points">
              <mxPoint x="158" y="160.5" />
              <mxPoint x="158" y="340" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="supplied-label" value="Supplied DAG:&lt;br&gt;bypass discovery;&lt;br&gt;review assumptions." vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;spacing=0;fontFamily=Helvetica;fontSize=12.3;fontColor=#397b71;fontStyle=0;align=center;verticalAlign=middle;">
          <mxGeometry as="geometry" x="17" y="292" width="128" height="70" />
        </mxCell>
        <mxCell id="optional-detector" value="&lt;div style=&quot;font-size:13px;font-weight:bold;color:#586873;&quot;&gt;Optional&lt;br&gt;detector / filter&lt;/div&gt;&lt;div style=&quot;font-size:12.3px;margin-top:5px;color:#203647;&quot;&gt;Separate branch&lt;br&gt;(Steps 5 and 7)&lt;br&gt;Unevaluated&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Helvetica;strokeColor=#586873;fillColor=#f0f5f6;strokeWidth=1.2;spacing=5;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="18" y="421" width="126" height="137" />
        </mxCell>
        <mxCell id="feedback" edge="1" parent="1" source="stage-6" target="stage-3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#586873;strokeWidth=1.3;endArrow=block;endFill=1;endSize=7;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;dashed=1;dashPattern=4 3;">
          <mxGeometry as="geometry" relative="1">
            <Array as="points">
              <mxPoint x="693" y="670" />
              <mxPoint x="693" y="340" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="feedback-label" value="Failed checks:&lt;br&gt;revisit the graph,&lt;br&gt;mechanisms, data&lt;br&gt;or target." vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;spacing=0;fontFamily=Helvetica;fontSize=12.3;fontColor=#586873;fontStyle=0;align=center;verticalAlign=middle;">
          <mxGeometry as="geometry" x="16" y="584" width="135" height="70" />
        </mxCell>
        <mxCell id="caption" value="Method families are alternatives, not a mandatory ensemble or an exhaustive comparison." vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;spacing=0;fontFamily=Helvetica;fontSize=12;fontColor=#586873;fontStyle=0;align=center;verticalAlign=middle;">
          <mxGeometry as="geometry" x="10" y="731" width="680" height="23" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>