*.log

# Docs
docs/methods
docs/STATUS.md

# --- Added with the causal-shap-target-dags consolidation (ADR 007) ---

# Quarto site render output (site/_site is built by CI; never committed)
site/_site/
site/.quarto/
.pytest_cache/
Thumbs.db
/build/
/dist/
.scratch/

# Local launcher configuration (detector paths, provider env) is machine-specific.
run_hub.local.bat

# PNG and CSV outputs are the canonical checked artifacts under analysis/output;
# duplicate PDFs stay local.
analysis/output/**/*.pdf

# Battery pilots stay local until a pinned full run receives scientific review.
analysis/output/battery_v1/
analysis/output/battery_v2/

# --- LumaWarp boundary (ADR 008). The detector runtime, the bridge that
