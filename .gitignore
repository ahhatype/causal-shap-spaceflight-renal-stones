# R / renv (renv.lock, renv/activate.R, renv/settings.json, .Rprofile ARE committed)
renv/library/
renv/staging/
renv/sandbox/
renv/local/
renv/python/
.Rhistory
.RData
.Rproj.user/

# Data & model artifacts. raw/interim/simulated are regenerated from source
